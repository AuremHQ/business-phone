{"@context":"https://schema.org","@graph":[{"@id":"https://auremcto.com/#organization","@type":"Organization","description":"Aurem builds local-first AI products. Aurem is a trademark application pending (CIPO application 2492318); it is not a registered trademark.","name":"Aurem","sameAs":["https://github.com/AuremHQ/business-phone"],"url":"https://auremcto.com"},{"@id":"https://github.com/AuremHQ/business-phone#product","@type":"SoftwareApplication","alternateName":"Business Phone","applicationCategory":"SecurityApplication","author":{"@id":"https://auremcto.com/#organization"},"description":"Concept for a secure business phone built on hardened Android (Pixel hardware), with a small open-weights language model on the phone acting as a gatekeeper. User data lives in an encrypted vault on the phone, local-only, zero telemetry. CONCEPT ONLY — nothing is built or tested.","featureList":"Encrypted on-device vault; policy engine with final allow/block/ask decision; open-weights gatekeeper model; local VPN traffic choke point; tamper-evident audit log; zero telemetry","isPartOf":{"@id":"https://auremcto.com/#organization"},"license":"https://github.com/AuremHQ/business-phone","name":"Aurem Guard","operatingSystem":"Android","softwareRequirements":"Hardened Android on Pixel hardware; open-weights gatekeeper model (starting pick: Qwen2.5-0.5B-Instruct, Apache 2.0)","url":"https://github.com/AuremHQ/business-phone"},{"@id":"https://github.com/AuremHQ/business-phone#website","@type":"WebSite","about":{"@id":"https://github.com/AuremHQ/business-phone#product"},"name":"Aurem Guard — Business Phone","publisher":{"@id":"https://auremcto.com/#organization"},"url":"https://github.com/AuremHQ/business-phone"}]}